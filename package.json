{
  "name": "railswap-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Consent-first railway berth exchange prototype with Flask, React, and a synthetic ML experiment",
  "scripts": {
    "backend": ".venv\\Scripts\\python.exe -m backend.app",
    "frontend": "npm --prefix frontend/frontend run dev",
    "seed": ".venv\\Scripts\\python.exe -m backend.seed --reset",
    "ml:generate": ".venv\\Scripts\\python.exe -m backend.ml.generate_dataset",
    "ml:train": ".venv\\Scripts\\python.exe -m backend.ml.train_model",
    "ml:evaluate": ".venv\\Scripts\\python.exe -m backend.ml.evaluate_model",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": ".venv\\Scripts\\python.exe -m pytest backend\\tests -q",
    "test:frontend": "npm --prefix frontend/frontend test",
    "build": "npm --prefix frontend/frontend run build"
  },
  "engines": {
    "node": ">=20"
  }
}
