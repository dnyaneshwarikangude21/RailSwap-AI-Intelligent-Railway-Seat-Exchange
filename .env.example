# RailSwap AI local configuration.
# Copy this file to .env for local use. Never commit a real .env.

# Replace both values before any shared or deployed environment.
# Use long random values, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
SECRET_KEY=replace-with-a-long-random-flask-secret-at-least-32-bytes
JWT_SECRET_KEY=replace-with-a-different-long-random-jwt-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_HOURS=12

# Optional. The default is backend/instance/railswap.db.
# DATABASE_URL=sqlite:///D:/absolute/path/to/railswap.db

# Comma-separated browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local development helpers.
AUTO_CREATE_DB=true
PORT=5000
FLASK_DEBUG=0

# Optional model/report overrides. Relative paths are resolved from the process
# working directory, so absolute paths are safer when overriding.
# ML_MODEL_PATH=D:/Railway seat exchange/backend/ml/saved_models/railswap_compatibility_rf.joblib
# ML_METRICS_PATH=D:/Railway seat exchange/backend/ml/saved_models/evaluation_metrics.json

MATCHING_RESULT_LIMIT=20
MAX_ACTIVE_MATCHES=5

# Frontend override (usually unnecessary because Vite proxies /api to Flask).
# Set this in frontend/frontend/.env.local, not the root .env.
# VITE_API_BASE_URL=http://127.0.0.1:5000/api
